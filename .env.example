# Database
DATABASE_URL=postgresql+asyncpg://memory:memory@localhost:5432/memory_agent
DATABASE_URL_SYNC=postgresql+psycopg://memory:memory@localhost:5432/memory_agent

# Postgres (used by docker-compose)
POSTGRES_USER=memory
POSTGRES_PASSWORD=memory
POSTGRES_DB=memory_agent
POSTGRES_PORT=5432

# Embedding backend. Default here is local Ollama (no proxy, no API key,
# good multilingual incl. Vietnamese). http only allowed for localhost / 127.0.0.1 / ::1;
# remote endpoints must use https.
#
# EMBEDDING_DIRECT=true bypasses LiteLLM and calls Ollama native POST /api/embeddings.
# When direct, EMBEDDING_API_BASE is preferred; falls back to LITELLM_API_BASE, then
# http://localhost:11434. Model prefix before the first / is stripped (ollama/bge-m3 -> bge-m3).
EMBEDDING_DIRECT=false
EMBEDDING_API_BASE=http://localhost:11434
LITELLM_API_BASE=http://localhost:11434
OPENAI_API_KEY=
EMBEDDING_MODEL=ollama/bge-m3
EMBEDDING_DIMENSIONS=1024
# To use OpenAI via LiteLLM: EMBEDDING_DIRECT=false, LITELLM_API_BASE=(unset or your proxy),
# OPENAI_API_KEY=sk-..., EMBEDDING_MODEL=text-embedding-3-small, EMBEDDING_DIMENSIONS=1536

# Retention / partitioning
L4_RETENTION_MONTHS=6

# App
# Prefer 127.0.0.1 for local-only; use 0.0.0.0 only behind a reverse proxy.
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# REST API key (required before exposing beyond localhost). MCP stdio ignores this.
# Send as header: X-API-Key: <value>  or  Authorization: Bearer <value>
MEMORY_API_KEY=
