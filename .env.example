# Database
DATABASE_URL=postgresql+asyncpg://memory:memory@localhost:5432/memory_agent
DATABASE_URL_SYNC=postgresql+psycopg://memory:memory@localhost:5432/memory_agent

# Postgres (used by docker-compose)
POSTGRES_USER=memory
POSTGRES_PASSWORD=memory
POSTGRES_DB=memory_agent
POSTGRES_PORT=5432

# LiteLLM proxy — credential trustee for OPENAI_API_KEY.
# http only allowed for localhost / 127.0.0.1 / ::1; remote proxies must use https.
# Leave empty to call the provider directly via the LiteLLM SDK.
LITELLM_API_BASE=http://localhost:4000
# Master/virtual key for the LiteLLM proxy (or real OpenAI key if LITELLM_API_BASE is empty)
OPENAI_API_KEY=sk-12345
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Retention / partitioning
L4_RETENTION_MONTHS=6

# App
# Prefer 127.0.0.1 for local-only; use 0.0.0.0 only behind a reverse proxy.
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# REST API key (required before exposing beyond localhost). MCP stdio ignores this.
# Send as header: X-API-Key: <value>  or  Authorization: Bearer <value>
MEMORY_API_KEY=
