# Copy to .env.local (git-ignored) and fill in real values there. Never put real values here.

# Database of this service, as the user bin/create-db-user.sh created (never a superuser).
# These values match the dev database of `make db-up`.
DATABASE_URL=postgresql+asyncpg://memory:memory@localhost:5432/agentic_memory
DATABASE_URL_SYNC=postgresql+psycopg://memory:memory@localhost:5432/agentic_memory
# Role query_deep_memory_sql runs as; bin/create-db-user.sh creates it.
SQL_READER_ROLE=agentic_memory_sql_reader

# Required. At least 32 characters. Every route except /health and /ready needs it,
# sent as X-API-Key or Authorization: Bearer. Generate one with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
MEMORY_API_KEY=

# Bind address of `make run`. Keep loopback unless a TLS reverse proxy sits in front.
APP_HOST=127.0.0.1
APP_PORT=8000
# Extra Host names accepted by /mcp behind a reverse proxy (comma-separated).
MCP_ALLOWED_HOSTS=

# Semantic search. false = no embedding calls and no semantic_search tool.
SEMANTIC_SEARCH_ENABLED=false
# true = call Ollama /api/embeddings directly; false = go through LiteLLM.
EMBEDDING_DIRECT=true
EMBEDDING_API_BASE=http://localhost:11434
EMBEDDING_MODEL=ollama/bge-m3
# Must match the vector column created by the first migration.
EMBEDDING_DIMENSIONS=1024
LITELLM_API_BASE=
OPENAI_API_KEY=

# Write limits: one raw payload; the content of one fact or note.
MAX_RAW_CHARS=200000
MAX_TEXT_CHARS=20000
# get_raw_context page size: default and largest.
RAW_PAGE_CHARS=8000
MAX_RAW_PAGE_CHARS=20000

# L4 raw events live this many months after their last touch.
L4_IDLE_RETENTION_MONTHS=6
# A touch writes at most once per this many days.
L4_TOUCH_MIN_DAYS=30

# Local file of personal strings (names, hosts, handles) that privacy-check blocks.
PRIVACY_DENYLIST_FILE=.privacy-denylist
