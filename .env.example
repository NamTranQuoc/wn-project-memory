# Database
DATABASE_URL=postgresql+asyncpg://memory:memory@localhost:5432/memory_agent
DATABASE_URL_SYNC=postgresql+psycopg://memory:memory@localhost:5432/memory_agent

# Postgres (used by docker-compose)
POSTGRES_USER=memory
POSTGRES_PASSWORD=memory
POSTGRES_DB=memory_agent
POSTGRES_PORT=5432

# OpenAI via LiteLLM
OPENAI_API_KEY=sk-your-key-here
DISTILLATION_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Retention / partitioning
L4_RETENTION_MONTHS=6

# App
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
