  "cards": [
    {
      "dot": "emerald",
      "title": "Agent merges",
      "items": [
        "The service never merges text",
        "On a conflict the agent combines the returned value with the new truth"
      ]
    },
    {
      "dot": "rose",
      "title": "No lost update",
      "items": [
        "create needs base 0; an existing key returns revision_conflict",
        "A stale base_revision is refused with the current value"
      ]
    },
    {
      "dot": "amber",
      "title": "Provenance",
      "items": [
        "Each revision keeps source_url and raw_event_id",
        "Citing a raw event renews it in L4"
      ]
    }
